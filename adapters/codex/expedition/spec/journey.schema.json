{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expedition.dev/journey.schema.json",
  "title": "Journey event",
  "description": "One line of an expeditions/{name}/journey.jsonl append-only log. Describes what happened; never prescribes what must happen.",
  "type": "object",
  "required": ["ts", "expedition", "schema", "type", "actor", "account"],
  "additionalProperties": false,
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "expedition": { "type": "string", "minLength": 1 },
    "schema": { "const": "1" },
    "type": {
      "enum": [
        "departure", "scout-report", "crossing", "basecamp", "dispatch",
        "rider", "word", "missive", "course-change", "arrival", "return", "account"
      ]
    },
    "actor": { "enum": ["patron", "frontiersman", "scout"] },
    "account": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "outcome": { "enum": ["succeeded", "failed"] },
    "category": { "type": "string", "minLength": 1 },
    "answer": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "crossing" } } },
      "then": { "required": ["outcome"] },
      "else": { "not": { "required": ["outcome"] } }
    },
    {
      "if": { "properties": { "type": { "const": "rider" } } },
      "then": { "required": ["category"] },
      "else": { "not": { "required": ["category"] } }
    },
    {
      "if": { "properties": { "type": { "const": "word" } } },
      "then": { "required": ["answer"] },
      "else": { "not": { "required": ["answer"] } }
    }
  ]
}
