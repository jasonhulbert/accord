#!/usr/bin/env python3
"""Install the stable ``accord`` command for the current plugin installation."""

from __future__ import annotations

import argparse
import os
import shlex
import stat
import sys
import tempfile
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = PLUGIN_ROOT / "bin" / "accord"
MARKER = "# Accord launcher; managed by Accord's installer."


def default_bin_dir() -> Path:
    """Return the conventional per-user executable directory."""
    if os.name == "nt":
        return Path(os.environ.get("LOCALAPPDATA", Path.home())) / "Accord" / "bin"
    return Path.home() / ".local" / "bin"


def write_executable(path: Path, contents: str) -> None:
    """Replace one launcher atomically and keep it executable."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=path.parent,
        prefix=f".{path.name}.",
        delete=False,
    ) as temporary:
        temporary.write(contents)
        temporary.flush()
        os.chmod(
            temporary.name,
            stat.S_IRUSR
            | stat.S_IWUSR
            | stat.S_IXUSR
            | stat.S_IRGRP
            | stat.S_IXGRP
            | stat.S_IROTH
            | stat.S_IXOTH,
        )
        temporary_path = Path(temporary.name)
    try:
        os.replace(temporary_path, path)
    except OSError:
        temporary_path.unlink(missing_ok=True)
        raise


def install(bin_dir: Path, force: bool) -> list[Path]:
    """Install the launcher and, on Windows, its command shim."""
    if not TEMPLATE.is_file():
        raise RuntimeError(f"launcher template is missing: {TEMPLATE}")
    contents = TEMPLATE.read_text(encoding="utf-8")
    hint = repr(str(PLUGIN_ROOT))
    contents = contents.replace(
        "PLUGIN_ROOT_HINT: str | None = None",
        f"PLUGIN_ROOT_HINT: str | None = {hint}",
    )
    if MARKER not in contents:
        raise RuntimeError(f"launcher template is missing its marker: {TEMPLATE}")

    destinations = [bin_dir / "accord"]
    if os.name == "nt":
        destinations.append(bin_dir / "accord.cmd")

    for destination in destinations:
        if destination.exists() and not force:
            existing = destination.read_text(encoding="utf-8", errors="replace")
            if MARKER not in existing:
                raise FileExistsError(
                    f"refusing to replace an existing non-Accord command: {destination}"
                )

    installed: list[Path] = []
    write_executable(destinations[0], contents)
    installed.append(destinations[0])
    if os.name == "nt":
        shim = (
            f"@rem {MARKER}\r\n"
            "@echo off\r\n"
            "py -3 \"%~dp0accord\" %*\r\n"
        )
        write_executable(destinations[1], shim)
        installed.append(destinations[1])
    return installed


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--bin-dir",
        type=Path,
        help="user executable directory (default: ~/.local/bin)",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="replace an existing command at the destination",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    bin_dir = (args.bin_dir or default_bin_dir()).expanduser().resolve()
    try:
        installed = install(bin_dir, args.force)
    except (FileExistsError, OSError, RuntimeError) as error:
        print(f"cannot install Accord command: {error}", file=sys.stderr)
        return 2

    for path in installed:
        print(f"installed {path}")
    path_entries = {
        Path(entry).expanduser().resolve()
        for entry in os.environ.get("PATH", "").split(os.pathsep)
        if entry
    }
    if bin_dir not in path_entries:
        if os.name == "nt":
            print(f"Add {bin_dir} to your user PATH before running: accord serve", file=sys.stderr)
        else:
            quoted = shlex.quote(str(bin_dir))
            print(
                f"Add {bin_dir} to PATH before running: "
                f"export PATH={quoted}:$PATH",
                file=sys.stderr,
            )
    else:
        print("Run `accord serve` from a target project root.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
