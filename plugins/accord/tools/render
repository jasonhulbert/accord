#!/usr/bin/env python3
"""Render record.jsonl files into a self-contained HTML timeline.

Usage: tools/render <record.jsonl> [more.jsonl ...] [-o record.html]

The output embeds its events and all CSS and JavaScript. It fetches nothing.
"""

from __future__ import annotations

import json
import sys
from html import escape
from pathlib import Path


TEMPLATE = r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TITLE__</title>
<style>
  :root {
    color-scheme: dark;
    --paper: #000;
    --ink: #f4f4ef;
    --muted: #8c8c88;
    --line: #383836;
    --running: #879b8a;
    --success: #a9bd72;
    --warning: #b9a06a;
    --danger: #bd7772;
    --human: #bd9a7a;
    --agent: #8da6ad;
    --supporting-agent: #a394b8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 15px/1.55 "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
  }
  main {
    width: min(1000px, calc(100% - 32px));
    margin: 0 auto;
    padding: 0 0 64px;
  }
  .view-nav {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font: 11px/1.4 "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .view-nav a { color: var(--ink); }
  header { padding: 42px 0 30px; border-bottom: 1px solid var(--line); }
  h1, h2 { font-weight: 600; letter-spacing: -0.04em; }
  h1 { margin: 0 0 10px; font-size: clamp(2.2rem, 7vw, 4.6rem); line-height: .95; }
  h2 { margin: 0; font-size: 1.45rem; }
  .intro { max-width: 650px; color: var(--muted); font-size: 1.05rem; }
  .task { margin-top: 0; }
  .task-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 20px 0 12px;
    border-bottom: 1px solid var(--line);
  }
  .count { color: var(--muted); font-size: .88rem; }
  .timeline { position: relative; margin-left: 12px; }
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
