  <div id="tasks"></div>
</main>
<script>
const EVENTS = __DATA__;
const tasks = new Map();
for (const event of EVENTS) {
  if (!tasks.has(event.task)) tasks.set(event.task, []);
  tasks.get(event.task).push(event);
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

function label(value) {
  return String(value).replaceAll("-", " ");
}

function addDetail(card, event) {
  const details = [];
  if (event.outcome) details.push(["Outcome", event.outcome]);
  if (event.subject) details.push(["Question", event.subject]);
  if (event.decision) details.push(["Direction", event.decision]);
  for (const [name, value] of details) {
    const line = element("p", "detail");
    const strong = element("strong", "", name + ": ");
    line.append(strong, document.createTextNode(value));
    card.appendChild(line);
  }
  if (event.refs && event.refs.length) {
    const list = element("ul", "refs");
    for (const ref of event.refs) {
      list.appendChild(element("li", "", ref));
    }
    card.appendChild(list);
  }
}

const root = document.getElementById("tasks");
for (const [taskName, events] of tasks) {
  const section = element("section", "task");
  const head = element("div", "task-head");
  head.append(
    element("h2", "", taskName),
    element("span", "count", events.length + (events.length === 1 ? " event" : " events"))
  );
  section.appendChild(head);

  const timeline = element("div", "timeline");
  for (const event of events) {
    const row = element("article", "event");
    row.dataset.actor = event.actor;
    row.dataset.type = event.type;
    if (event.outcome) row.dataset.outcome = event.outcome;
    row.appendChild(element("span", "dot"));

    const card = element("div", "card");
    const meta = element("div", "meta");
    meta.append(
      element("span", "type", label(event.type)),
      element("span", "", label(event.actor)),
      element("time", "", event.ts)
    );
    card.append(
      meta,
      element("p", "summary", event.summary)
    );
    addDetail(card, event);
    row.appendChild(card);
    timeline.appendChild(row);
  }
  section.appendChild(timeline);
  root.appendChild(section);
}
</script>
__LIVE_SCRIPT__
</body>
</html>
"""


def parse_args(argv: list[str]) -> tuple[list[str], str] | None:
    """Parse the deliberately small command-line interface."""
    output = "record.html"
    files = []
    index = 0
    while index < len(argv):
        if argv[index] == "-o":
            if index + 1 >= len(argv):
                print("-o requires an output path", file=sys.stderr)
                return None
            output = argv[index + 1]
            index += 2
        else:
            files.append(argv[index])
            index += 1
    if not files:
        print(__doc__.strip(), file=sys.stderr)
        return None
    return files, output


def read_events(files: list[str]) -> list[dict] | None:
    """Read JSONL input and report exact file and line failures."""
    events, error = parse_events(files)
    if error:
        print(error, file=sys.stderr)
        return None
    return events


def parse_events(files: list[str]) -> tuple[list[dict] | None, str | None]:
    """Read JSONL input and return a user-facing error without printing it."""
    events = []
    required = {"ts", "task", "schema", "type", "actor", "summary"}
    for path_string in files:
        try:
            lines = Path(path_string).read_text().splitlines()
        except OSError as error:
            return None, f"{path_string}: cannot read: {error}"
        for line_number, raw in enumerate(lines, 1):
            if not raw.strip():
                continue
            try:
                event = json.loads(raw)
            except json.JSONDecodeError as error:
                return None, f"{path_string}:{line_number}: invalid JSON: {error}"
            if not isinstance(event, dict):
                return None, f"{path_string}:{line_number}: event is not a JSON object"
            missing = sorted(required - event.keys())
            if missing:
                return None, (
                    f"{path_string}:{line_number}: missing required fields "
                    f"{', '.join(missing)}"
                )
            events.append(event)
    return events, None


def build_html(
    events: list[dict],
    *,
    title: str = "Accord record",
    heading: str = "Accord record",
    intro: str = (
        "A factual view of what changed, where judgment returned to the "
        "human, and how the work responded to evidence."
    ),
    nav: str = "",
    live: bool = False,
) -> str:
    """Build the shared record page for static or live delivery."""
    embedded = json.dumps(events, separators=(",", ":")).replace("<", "\\u003c")
    live_script = (
        '<script>setTimeout(() => window.location.reload(), 2000);</script>'
        if live
        else ""
    )
    return (
        TEMPLATE.replace("__TITLE__", escape(title))
        .replace("__HEADING__", escape(heading))
        .replace("__INTRO__", escape(intro))
        .replace("__NAV__", nav)
        .replace("__LIVE_SCRIPT__", live_script)
        .replace("__DATA__", embedded)
    )


def main(argv: list[str]) -> int:
    parsed = parse_args(argv)
    if parsed is None:
        return 2
    files, output = parsed
    events = read_events(files)
    if events is None:
        return 1

    html = build_html(events)
    try:
        Path(output).write_text(html)
    except OSError as error:
        print(f"{output}: cannot write: {error}", file=sys.stderr)
        return 2
    print(f"rendered {len(events)} events from {len(files)} file(s) to {output}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
