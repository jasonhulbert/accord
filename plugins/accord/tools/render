#!/usr/bin/env python3
"""Render record.jsonl files into an offline HTML timeline and local assets.

Usage: tools/render <record.jsonl> [more.jsonl ...] [-o record.html]

The output embeds its events and presentation code. Mermaid modules are copied
to a sibling asset directory. The generated directory fetches nothing.
"""

from __future__ import annotations

import base64
from functools import lru_cache
import json
import shutil
import sys
from html import escape
from pathlib import Path


FONT_ROOT = Path(__file__).resolve().parent.parent / "assets" / "fonts"
WEB_ROOT = Path(__file__).resolve().parent.parent / "assets" / "web"
VIEW_TEMPLATE = WEB_ROOT / "record.html"
FONT_SPECS = (
    ("IBM Plex Sans", "IBMPlexSans-Regular.woff2", 400),
    ("IBM Plex Sans", "IBMPlexSans-SemiBold.woff2", 600),
    ("IBM Plex Sans", "IBMPlexSans-Bold.woff2", 700),
    ("IBM Plex Mono", "IBMPlexMono-Regular.woff2", 400),
)


@lru_cache(maxsize=1)
def font_css() -> str:
    """Embed the shipped IBM Plex faces so every rendered page stays offline."""
    faces = []
    for family, filename, weight in FONT_SPECS:
        encoded = base64.b64encode((FONT_ROOT / filename).read_bytes()).decode("ascii")
        faces.append(
            "  @font-face {\n"
            f'    font-family: "{family}";\n'
            f"    src: url(data:font/woff2;base64,{encoded}) format(\"woff2\");\n"
            f"    font-weight: {weight};\n"
            "    font-style: normal;\n"
            "    font-display: swap;\n"
            "  }"
        )
    return "\n".join(faces)


@lru_cache(maxsize=1)
def view_template() -> str:
    """Read the generated web distribution consumed by static and served views."""
    return VIEW_TEMPLATE.read_text()


def parse_args(argv: list[str]) -> tuple[list[str], str] | None:
    """Parse the deliberately small command-line interface."""
    output = "record.html"
    files = []
    index = 0
    while index < len(argv):
        if argv[index] == "-o":
            if index + 1 >= len(argv):
                print("-o requires an output path", file=sys.stderr)
                return None
            output = argv[index + 1]
            index += 2
        else:
            files.append(argv[index])
            index += 1
    if not files:
        print(__doc__.strip(), file=sys.stderr)
        return None
    return files, output


def read_events(files: list[str]) -> list[dict] | None:
    """Read JSONL input and report exact file and line failures."""
    events, error = parse_events(files)
    if error:
        print(error, file=sys.stderr)
        return None
    return events


def parse_events(files: list[str]) -> tuple[list[dict] | None, str | None]:
    """Read JSONL input and return a user-facing error without printing it."""
    events = []
    required = {"ts", "task", "schema", "type", "actor", "summary"}
    for path_string in files:
        try:
            lines = Path(path_string).read_text().splitlines()
        except OSError as error:
            return None, f"{path_string}: cannot read: {error}"
        for line_number, raw in enumerate(lines, 1):
            if not raw.strip():
                continue
            try:
                event = json.loads(raw)
            except json.JSONDecodeError as error:
                return None, f"{path_string}:{line_number}: invalid JSON: {error}"
            if not isinstance(event, dict):
                return None, f"{path_string}:{line_number}: event is not a JSON object"
            missing = sorted(required - event.keys())
            if missing:
                return None, (
                    f"{path_string}:{line_number}: missing required fields "
                    f"{', '.join(missing)}"
                )
            events.append(event)
    return events, None


def document_title(path: Path, content: str) -> str:
    """Use the document's first Markdown heading, then its filename."""
    for line in content.splitlines():
        if line.startswith("# "):
            return line.removeprefix("# ").strip()
    return path.stem.replace("-", " ")


def collect_documents(files: list[str], events: list[dict]) -> list[dict]:
    """Read task documents and anchor them to the events that reference them."""
    documents = []
    seen = set()
    events_by_task: dict[str, list[dict]] = {}
    for event in events:
        events_by_task.setdefault(event["task"], []).append(event)

    for path_string in files:
        task_dir = Path(path_string).parent
        task = task_dir.name
        task_events = events_by_task.get(task, [])
        candidates: list[tuple[str, Path]] = []
        agreement = task_dir / "agreement.md"
        if agreement.is_file():
            candidates.append(("agreement", agreement))
        reports = task_dir / "reports"
        if reports.is_dir():
            candidates.extend(("report", path) for path in sorted(reports.glob("*.md")))
        candidates.extend(
            ("learning", path) for path in sorted(task_dir.glob("learning*.md"))
        )
        for event in task_events:
            for ref in event.get("refs", []):
                ref_path = Path(ref)
                if (
                    len(ref_path.parts) >= 2
                    and ref_path.parts[0] == "diagrams"
                    and ".." not in ref_path.parts
                    and ref_path.suffix == ".md"
                ):
                    candidates.append(("visual-explanation", task_dir / ref_path))

        for kind, path in candidates:
            ref = path.relative_to(task_dir).as_posix()
            key = (task, ref)
            if key in seen:
                continue
            seen.add(key)
            try:
                content = path.read_text()
                read_error = None
            except OSError as error:
                read_error = f"Accord could not read this document: {error}"
                content = read_error

            preferred_type = {
                "agreement": "start",
                "report": "report",
                "learning": "note",
                "visual-explanation": None,
            }[kind]
            after = next(
                (
                    index
                    for index, event in enumerate(task_events)
                    if preferred_type is not None
                    and event["type"] == preferred_type
                    and ref in event.get("refs", [])
                ),
                None,
            )
            if after is None:
                after = next(
                    (
                        index
                        for index, event in enumerate(task_events)
                        if ref in event.get("refs", [])
                    ),
                    None,
                )
            if after is None and kind == "agreement":
                after = next(
                    (
                        index
                        for index, event in enumerate(task_events)
                        if event["type"] == "start"
                    ),
                    None,
                )
            documents.append(
                {
                    "task": task,
                    "ref": ref,
                    "kind": kind,
                    "title": document_title(path, content),
                    "content": content,
                    "after": after,
                    "error": read_error is not None,
                }
            )
    return documents


def build_html(
    events: list[dict],
    *,
    documents: list[dict] | None = None,
    title: str = "Accord record",
    heading: str = "Accord record",
    intro: str = (
        "A factual view of what changed, where judgment returned to the "
        "human, and how the work responded to evidence."
    ),
    nav: str = "",
    asset_base: str = "/assets/web",
) -> str:
    """Build the shared record page for static or served delivery."""
    embedded = json.dumps(events, separators=(",", ":")).replace("<", "\\u003c")
    embedded_documents = json.dumps(
        documents or [], separators=(",", ":")
    ).replace("<", "\\u003c")
    return (
        view_template().replace("__TITLE__", escape(title))
        .replace("__HEADING__", escape(heading))
        .replace("__INTRO__", escape(intro))
        .replace("__NAV__", nav)
        .replace("__FONT_CSS__", font_css())
        .replace("__ASSET_BASE__", asset_base)
        .replace("__LIVE_SCRIPT__", "")
        .replace("__DOCUMENTS__", embedded_documents)
        .replace("__DATA__", embedded)
    )


def main(argv: list[str]) -> int:
    parsed = parse_args(argv)
    if parsed is None:
        return 2
    files, output = parsed
    events = read_events(files)
    if events is None:
        return 1

    output_path = Path(output)
    asset_name = output_path.stem + ".assets"
    html = build_html(
        events,
        documents=collect_documents(files, events),
        asset_base=asset_name,
    )
    try:
        output_path.write_text(html)
        shutil.copytree(
            WEB_ROOT / "mermaid",
            output_path.with_name(asset_name),
            dirs_exist_ok=True,
        )
    except OSError as error:
        print(f"{output}: cannot write: {error}", file=sys.stderr)
        return 2
    print(f"rendered {len(events)} events from {len(files)} file(s) to {output}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
