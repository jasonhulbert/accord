#!/usr/bin/env python3
"""List active and archived Accord work for the current project."""

from __future__ import annotations

import json
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
VALIDATOR = PLUGIN_ROOT / "tools" / "validate"
sys.path.insert(0, str(PLUGIN_ROOT))

from storage import (  # noqa: E402
    accord_archive_root_for,
    accord_home,
    accord_root_for,
    symlink_component_below,
)


@dataclass(frozen=True)
class Work:
    """One stored work entry and any condition that needs attention."""

    task: str
    storage: str
    problem: str | None = None


class ListError(Exception):
    """A storage condition prevents a trustworthy list."""


def record_problem(task_dir: Path) -> str | None:
    """Describe why one direct work entry cannot be trusted."""
    if task_dir.is_symlink():
        return "task directory is a symlink"
    if not task_dir.is_dir():
        return "storage entry is not a directory"

    record = task_dir / "record.jsonl"
    if record.is_symlink():
        return "record.jsonl is a symlink"
    if not record.is_file():
        return "record.jsonl is missing"

    try:
        lines = record.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        return f"record.jsonl could not be read: {error}"
    if not any(line.strip() for line in lines):
        return "record.jsonl is empty"
    try:
        events = [json.loads(line) for line in lines if line.strip()]
    except json.JSONDecodeError:
        return "record.jsonl is not valid JSON"
    if any(
        not isinstance(event, dict) or event.get("task") != task_dir.name
        for event in events
    ):
        return "record events do not name this work"
    try:
        result = subprocess.run(
            [sys.executable, str(VALIDATOR), str(record)],
            check=False,
            capture_output=True,
            text=True,
            timeout=8,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return f"record validation could not run: {error}"
    if result.returncode != 0:
        return "record.jsonl is invalid"
    return None


def work_in(root: Path, storage: str) -> list[Work]:
    """Return direct work entries without following unsafe storage."""
    unsafe_root = symlink_component_below(accord_home(), root)
    if unsafe_root is not None:
        raise ListError(f"{storage} storage contains a symlink at {unsafe_root}")
    if not root.exists():
        return []
    if not root.is_dir():
        raise ListError(f"{storage} storage is not a directory: {root}")

    try:
        entries = sorted(root.iterdir(), key=lambda path: path.name)
    except OSError as error:
        raise ListError(f"{storage} storage could not be read: {error}") from error
    return [
        Work(entry.name, storage, record_problem(entry))
        for entry in entries
    ]


def list_work(cwd: Path) -> list[Work]:
    """Return active work first, then archived work, each sorted by task ID."""
    return [
        *work_in(accord_root_for(cwd), "active"),
        *work_in(accord_archive_root_for(cwd), "archived"),
    ]


def main(argv: list[str]) -> int:
    if argv:
        stream = sys.stdout if argv == ["--help"] or argv == ["-h"] else sys.stderr
        print(__doc__, file=stream)
        return 0 if stream is sys.stdout else 2

    try:
        work = list_work(Path.cwd())
    except ListError as error:
        print(f"cannot list Accord work: {error}", file=sys.stderr)
        return 2

    if not work:
        print("No Accord work found for this project.")
        return 0

    width = max(len(item.storage) for item in work)
    for item in work:
        print(f"{item.storage.upper():<{width}}  {item.task}")
        if item.problem:
            print(
                f"WARNING: {item.storage} work {item.task!r} needs attention: "
                f"{item.problem}",
                file=sys.stderr,
            )
    return 2 if any(item.problem for item in work) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
