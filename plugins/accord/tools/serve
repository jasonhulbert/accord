def record_logs(accord_root: Path) -> list[Path]:
    """Return direct task records in stable task-name order."""
    return sorted(
        (path for path in accord_root.glob("*/record.jsonl") if path.is_file()),
        key=lambda path: path.parent.name,
    )


def record_for(accord_root: Path, task: str) -> Path | None:
    """Resolve a task name only to a direct record under the project store."""
    if not task or "/" in task or "\\" in task or task in {".", ".."}:
        return None
    for record in record_logs(accord_root):
        if record.parent.name == task:
            return record
    return None


def index_content(accord_root: Path) -> str:
    """Build the task chooser without selecting a record for the user."""
    records = record_logs(accord_root)
    if not records:
        content = '<p class="empty">No Accord records were found for this project yet.</p>'
        return (
            INDEX_TEMPLATE.replace("__FONT_CSS__", font_css())
            .replace("__CONTENT__", content)
        )

    cards = []
    for record in records:
        task = record.parent.name
        events, error = parse_events([str(record)])
        if error:
            cards.append(
                '<li class="record invalid">'
                f'<div class="record-head"><h2><span class="status-mark status-mark-error" aria-hidden="true"></span>{escape(task)}</h2>'
                f'<span class="meta">needs attention</span></div>'
                f'<p class="error">{escape(error)}</p>'
                f'<p><a href="/task/{quote(task, safe="")}">Open record</a></p>'
                "</li>"
            )
            continue

        count = len(events)
        if events:
            last = events[-1]
            summary = f"{count} {'event' if count == 1 else 'events'} · last {last['type']} at {last['ts']}"
        else:
            summary = "empty record"
        cards.append(
            '<li class="record">'
            f'<div class="record-head"><h2><span class="status-mark" aria-hidden="true"></span><a href="/task/{quote(task, safe="")}">{escape(task)}</a></h2></div>'
            f'<p class="meta">{escape(summary)}</p>'
            "</li>"
        )

    content = '<ul class="records">' + "".join(cards) + "</ul>"
    return (
        INDEX_TEMPLATE.replace("__FONT_CSS__", font_css())
        .replace("__CONTENT__", content)
    )


def error_page(heading: str, message: str) -> str:
    """Render an escaped, actionable record error page."""
    return (
        ERROR_TEMPLATE.replace("__FONT_CSS__", font_css())
        .replace("__HEADING__", escape(heading))
        .replace("__ERROR__", escape(message))
    )


def make_handler(accord_root: Path):
    """Create a request handler bound to one project's record root."""

    class RecordHandler(BaseHTTPRequestHandler):
        def send_html(self, body: str, status: int = 200) -> None:
            payload = body.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(payload)

        def send_web_asset(self, relative_path: str) -> None:
            candidate = (WEB_ROOT / relative_path).resolve()
            if not candidate.is_relative_to(WEB_ROOT.resolve()) or not candidate.is_file():
                self.send_html(error_page("Asset not found", relative_path), 404)
                return
            content_type = {
                ".js": "text/javascript; charset=utf-8",
                ".txt": "text/plain; charset=utf-8",
                ".md": "text/markdown; charset=utf-8",
            }.get(candidate.suffix, "application/octet-stream")
            payload = candidate.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-cache")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self) -> None:  # noqa: N802
            path = urlsplit(self.path).path
            if path == "/":
                self.send_html(index_content(accord_root))
                return

            if path.startswith("/assets/web/"):
                self.send_web_asset(unquote(path.removeprefix("/assets/web/")))
                return

            if path.startswith("/task/"):
                task = unquote(path.removeprefix("/task/"))
                record = record_for(accord_root, task)
                if record is None:
                    self.send_html(error_page("Record not found", task), 404)
                    return
                events, error = parse_events([str(record)])
                if error:
                    self.send_html(error_page(task, error), 422)
                    return
                nav = '<a href="/">All records</a> · live view'
                html = build_html(
                    events,
                    documents=collect_documents([str(record)], events),
                    title=f"{task} — Accord",
                    heading=task,
                    intro=(
                        "A live view of this Accord record. It refreshes while "
                        "the work is in progress."
                    ),
                    nav=nav,
                    live=True,
                )
                self.send_html(html)
                return

            self.send_html(error_page("Page not found", path), 404)

    return RecordHandler


class LocalServer(ThreadingHTTPServer):
    """A reusable, threaded server that is intentionally local-only."""

    allow_reuse_address = True
    daemon_threads = True


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    parser.add_argument(
        "--task", help="open one record by task ID instead of the record list"
    )
    parser.add_argument(
        "--port",
        type=int,
        default=0,
        help="local port to use (default: choose an available port)",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help="print the URL without opening a browser",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    accord_root = accord_root_for(Path.cwd())
    if args.task and record_for(accord_root, args.task) is None:
        print(
            f"{args.task!r}: no Accord record found for this project",
            file=sys.stderr,
        )
        return 2

    try:
        server = LocalServer(("127.0.0.1", args.port), make_handler(accord_root))
    except OSError as error:
        print(f"cannot start local Accord web view: {error}", file=sys.stderr)
        return 2

    path = "/" if not args.task else f"/task/{quote(args.task, safe='')}"
    url = f"http://127.0.0.1:{server.server_address[1]}{path}"
    print(f"Accord web view: {url}", flush=True)
    if not args.no_open:
        webbrowser.open(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nAccord web view stopped.")
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
