{
  "description": "Read-only Accord context and record validation.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\session_start.py\"",
            "timeout": 10,
            "statusMessage": "Reading Accord records"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\post_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Checking Accord records"
          }
        ]
      }
    ]
  }
}
