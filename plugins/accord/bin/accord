#!/usr/bin/env python3
"""Stable user-facing launcher for the Accord plugin."""

from __future__ import annotations

import os
import sys
from pathlib import Path


# The installer replaces this hint with the plugin root it was run from.
PLUGIN_ROOT_HINT: str | None = None
LAUNCHER_MARKER = "# Accord launcher; managed by Accord's installer."


def candidate_roots() -> list[Path]:
    """Return likely plugin roots, newest versioned roots first."""
    roots: list[Path] = []

    if PLUGIN_ROOT_HINT:
        hinted = Path(PLUGIN_ROOT_HINT).expanduser()
        roots.append(hinted)
        if hinted.parent.is_dir():
            roots.extend(
                candidate
                for candidate in sorted(hinted.parent.iterdir(), reverse=True)
                if candidate.is_dir()
            )

    here = Path(__file__).resolve()
    roots.append(here.parent.parent)

    for family in (
        Path.home() / ".codex" / "plugins" / "cache" / "accord" / "accord",
        Path.home() / ".claude" / "plugins" / "cache" / "accord" / "accord",
    ):
        if family.is_dir():
            roots.extend(
                candidate
                for candidate in sorted(family.iterdir(), reverse=True)
                if candidate.is_dir()
            )

    codex_marketplaces = Path.home() / ".codex" / ".tmp" / "marketplaces"
    if codex_marketplaces.is_dir():
        roots.extend(
            candidate
            for candidate in codex_marketplaces.glob("*/plugins/accord")
            if candidate.is_dir()
        )

    unique: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        resolved = root.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        unique.append(resolved)
    return unique


def find_server() -> Path | None:
    """Find the current installed server without relying on one cache version."""
    for root in candidate_roots():
        server = root / "tools" / "serve"
        if server.is_file():
            return server
    return None


def usage() -> str:
    return "Usage: accord serve [--task TASK] [--port PORT] [--no-open]"


def main(argv: list[str]) -> int:
    if not argv or argv == ["--help"] or argv == ["-h"]:
        print(usage())
        return 0 if argv else 2
    if argv[0] != "serve":
        print(f"unknown command: {argv[0]}", file=sys.stderr)
        print(usage(), file=sys.stderr)
        return 2

    server = find_server()
    if server is None:
        print(
            "cannot find the installed Accord web server; "
            "rerun the Accord launcher installer",
            file=sys.stderr,
        )
        return 2

    os.execv(sys.executable, [sys.executable, str(server), *argv[1:]])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
