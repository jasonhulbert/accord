#!/usr/bin/env python3
"""Stable user-facing launcher for the Accord plugin."""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path


# The installer replaces this hint with the plugin root it was run from.
PLUGIN_ROOT_HINT: str | None = None
LAUNCHER_MARKER = "# Accord launcher; managed by Accord's installer."
SERVE_RUNTIME_PATHS = (
    Path("tools/serve"),
    Path("tools/render"),
    Path("storage.py"),
    Path("assets/web/record.html"),
    Path("assets/web/mermaid/mermaid.js"),
    Path("assets/fonts/IBMPlexMono-Regular.woff2"),
    Path("assets/fonts/IBMPlexSans-Bold.woff2"),
    Path("assets/fonts/IBMPlexSans-Regular.woff2"),
    Path("assets/fonts/IBMPlexSans-SemiBold.woff2"),
)
ARCHIVE_RUNTIME_PATHS = (
    Path("tools/archive"),
    Path("tools/validate"),
    Path("storage.py"),
)


def version_key(path: Path) -> tuple[tuple[int, int | str], ...]:
    """Sort version-like directory names by their numeric components."""
    return tuple(
        (1, int(part)) if part.isdigit() else (0, part.casefold())
        for part in re.split(r"(\d+)", path.name)
        if part
    )


def candidate_roots() -> list[Path]:
    """Return likely plugin roots, newest versioned roots first."""
    roots: list[Path] = []

    if PLUGIN_ROOT_HINT:
        hinted = Path(PLUGIN_ROOT_HINT).expanduser()
        if hinted.parent.is_dir():
            roots.extend(
                candidate
                for candidate in sorted(
                    hinted.parent.iterdir(), key=version_key, reverse=True
                )
                if candidate.is_dir()
            )
        roots.append(hinted)

    here = Path(__file__).resolve()
    roots.append(here.parent.parent)

    for family in (
        Path.home() / ".codex" / "plugins" / "cache" / "accord" / "accord",
        Path.home() / ".claude" / "plugins" / "cache" / "accord" / "accord",
    ):
        if family.is_dir():
            roots.extend(
                candidate
                for candidate in sorted(
                    family.iterdir(), key=version_key, reverse=True
                )
                if candidate.is_dir()
            )

    codex_marketplaces = Path.home() / ".codex" / ".tmp" / "marketplaces"
    if codex_marketplaces.is_dir():
        roots.extend(
            candidate
            for candidate in codex_marketplaces.glob("*/plugins/accord")
            if candidate.is_dir()
        )

    unique: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        resolved = root.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        unique.append(resolved)
    return unique


def find_plugin_root(required_paths: tuple[Path, ...]) -> Path | None:
    """Find a complete plugin installation without relying on one cache version."""
    for root in candidate_roots():
        if all((root / path).is_file() for path in required_paths):
            return root
    return None


def usage() -> str:
    return "\n".join(
        [
            "Usage:",
            "  accord serve [--archived] [--task TASK] [--port PORT] [--no-open]",
            "  accord archive [--force] TASK",
            "  accord restore TASK",
        ]
    )


def main(argv: list[str]) -> int:
    if not argv or argv == ["--help"] or argv == ["-h"]:
        print(usage())
        return 0 if argv else 2
    if argv[0] not in {"serve", "archive", "restore"}:
        print(f"unknown command: {argv[0]}", file=sys.stderr)
        print(usage(), file=sys.stderr)
        return 2

    required_paths = (
        SERVE_RUNTIME_PATHS if argv[0] == "serve" else ARCHIVE_RUNTIME_PATHS
    )
    plugin_root = find_plugin_root(required_paths)
    if plugin_root is None:
        print(
            "cannot find a complete Accord plugin installation; "
            "update or reinstall Accord, then rerun the Accord launcher installer",
            file=sys.stderr,
        )
        return 2

    if argv[0] == "serve":
        tool = plugin_root / "tools" / "serve"
        arguments = argv[1:]
    else:
        tool = plugin_root / "tools" / "archive"
        arguments = argv
    os.execv(sys.executable, [sys.executable, str(tool), *arguments])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
