#!/bin/sh
# Vendor the framework into the Claude and Codex skill adapters, then package
# the Claude skills as expedition.skill and expedition-missive.skill.
set -eu

repo=$(cd "$(dirname "$0")/.." && pwd)
skills="expedition expedition-missive"

vendor() {
  skill=$1
  mkdir -p "$skill/creed" "$skill/templates" "$skill/spec"
  cp "$repo"/creed/*.md "$skill/creed/"
  cp "$repo"/templates/*.md "$skill/templates/"
  cp "$repo"/spec/journey-state.md "$repo"/spec/journey.schema.json \
     "$repo"/spec/lexicon.md "$repo"/spec/missive.md "$skill/spec/"
}

for name in $skills; do
  vendor "$repo/adapters/claude/$name"
  vendor "$repo/adapters/codex/$name"
done

# Self-containment check: no references escaping the skill folders.
for name in $skills; do
  for skill in "$repo/adapters/claude/$name" "$repo/adapters/codex/$name"; do
    if grep -rn '\.\./' "$skill" >/dev/null 2>&1; then
      echo "build-skill: skill folder contains relative references outside itself:" >&2
      grep -rn '\.\./' "$skill" >&2
      exit 1
    fi
    echo "synced $skill"
  done
done

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
for name in $skills; do
  out="$repo/$name.skill"
  rm -rf "$stage/$name" && cp -R "$repo/adapters/claude/$name" "$stage/$name"
  rm -f "$out"
  (cd "$stage" && zip -qr "$out" "$name")
  echo "built $out"
  unzip -l "$out"
done
