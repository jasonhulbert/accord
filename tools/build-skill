#!/bin/sh
# Vendor the framework into the Claude and Codex skill adapters, then package
# the Claude skill as expedition.skill.
set -eu

repo=$(cd "$(dirname "$0")/.." && pwd)
claude="$repo/adapters/claude"
codex="$repo/adapters/codex/expedition"
out="$repo/expedition.skill"

vendor() {
  skill=$1
  mkdir -p "$skill/creed" "$skill/templates" "$skill/spec"
  cp "$repo"/creed/*.md "$skill/creed/"
  cp "$repo"/templates/*.md "$skill/templates/"
  cp "$repo"/spec/journey-state.md "$repo"/spec/journey.schema.json "$repo"/spec/lexicon.md "$skill/spec/"
}

vendor "$claude"
vendor "$codex"

# Self-containment check: no references escaping the skill folder.
for skill in "$claude" "$codex"; do
  if grep -rn '\.\./' "$skill" >/dev/null 2>&1; then
    echo "build-skill: skill folder contains relative references outside itself:" >&2
    grep -rn '\.\./' "$skill" >&2
    exit 1
  fi
done

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp -R "$claude" "$stage/expedition"
rm -f "$out"
(cd "$stage" && zip -qr "$out" expedition)
echo "synced $codex"
echo "built $out"
unzip -l "$out"
