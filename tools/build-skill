#!/bin/sh
# Build expedition.skill: vendor canon, templates, and spec essentials into
# adapters/claude/ and zip it with the structure expedition/SKILL.md + folders.
set -eu

repo=$(cd "$(dirname "$0")/.." && pwd)
skill="$repo/adapters/claude"
out="$repo/expedition.skill"

mkdir -p "$skill/code" "$skill/templates" "$skill/spec"
cp "$repo"/code/*.md "$skill/code/"
cp "$repo"/templates/*.md "$skill/templates/"
cp "$repo"/spec/journey-state.md "$repo"/spec/journey.schema.json "$repo"/spec/lexicon.md "$skill/spec/"

# Self-containment check: no references escaping the skill folder.
if grep -rn '\.\./' "$skill" >/dev/null 2>&1; then
  echo "build-skill: skill folder contains relative references outside itself:" >&2
  grep -rn '\.\./' "$skill" >&2
  exit 1
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp -R "$skill" "$stage/expedition"
rm -f "$out"
(cd "$stage" && zip -qr "$out" expedition)
echo "built $out"
unzip -l "$out"
