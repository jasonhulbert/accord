#!/usr/bin/env python3
"""Render one or more journey.jsonl files into a self-contained HTML map.

Usage: tools/render <journey.jsonl> [more.jsonl ...] [-o map.html]

The output embeds the events and all CSS/JS inline; it fetches nothing.
"""
import json
import sys
from pathlib import Path

TEMPLATE = r"""<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Journey map</title>
<style>
  :root { --ink:#2b2620; --paper:#f5efe3; --faint:#b9ad97; --fail:#a8442e;
          --rider:#5b6e8c; --camp:#6b5a3e; --arrive:#3f6e46; }
  @media (prefers-color-scheme: dark) {
    :root { --ink:#e8e0d0; --paper:#211d17; --faint:#5a5142; --fail:#d97b62;
            --rider:#8fa3c4; --camp:#c0a878; --arrive:#7fae87; }
  }
  body { background:var(--paper); color:var(--ink);
         font:15px/1.5 Georgia, 'Times New Roman', serif; margin:2rem; }
  h1 { font-weight:normal; letter-spacing:.04em; }
  h2 { font-weight:normal; border-bottom:1px solid var(--faint); padding-bottom:.2em; }
  .map { overflow-x:auto; }
  svg { display:block; }
  .legend { font-size:13px; color:var(--faint); margin:.5em 0 2em; }
  .evt { cursor:default; }
  .tip { position:fixed; max-width:26em; background:var(--paper); color:var(--ink);
         border:1px solid var(--faint); padding:.6em .8em; font-size:13px;
         pointer-events:none; display:none; box-shadow:0 2px 8px rgba(0,0,0,.25); }
</style>
</head>
<body>
<h1>Journey map</h1>
<p class="legend">The faint line is the route as planned from home; the solid line is the path the company walked.
Squares are basecamps; short spurs ending in &times; are failed crossings; loops rising to the upper band are riders
sent home and the word that returned. Hover any mark for its account.</p>
<div id="maps"></div>
<div class="tip" id="tip"></div>
<script>
const JOURNEYS = __DATA__;

const tip = document.getElementById('tip');
function showTip(e, ev) {
  tip.style.display = 'block';
  tip.innerHTML = '<b>' + ev.type + '</b> — ' + ev.actor + ' — ' + ev.ts +
    (ev.outcome ? ' — ' + ev.outcome : '') +
    (ev.category ? ' — ' + ev.category : '') +
    '<br>' + esc(ev.account) + (ev.answer ? '<br><i>word: ' + esc(ev.answer) + '</i>' : '');
  tip.style.left = Math.min(e.clientX + 14, innerWidth - 420) + 'px';
  tip.style.top  = (e.clientY + 14) + 'px';
}
function esc(s){ return String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }

function render(name, events) {
  const STEP = 90, X0 = 60, BASE = 190, RIDERY = 60, H = 300;
  const W = X0 + STEP * (events.length + 1);
  const css = getComputedStyle(document.documentElement);
  const col = v => css.getPropertyValue(v).trim();

  // walk the path: y wanders a little at course changes
  let y = BASE, pts = [], marks = [];
  events.forEach((ev, i) => {
    const x = X0 + STEP * (i + 1);
    if (ev.type === 'course-change') y += (y > BASE ? -1 : 1) * 34;
    if (ev.type === 'crossing' && ev.outcome === 'failed') {
      // dead-end spur, then the path resumes from the previous point
      marks.push({kind:'spur', x, y: y - 0, ev});
    } else {
      pts.push([x, y]);
      marks.push({kind: ev.type, x, y, ev});
    }
  });

  let svg = [];
  const terminal = events[events.length - 1];
  // planned route: faint straight line from departure toward the horizon
  svg.push(`<line x1="${X0}" y1="${BASE}" x2="${W - 20}" y2="${BASE}"
    stroke="${col('--faint')}" stroke-width="2" stroke-dasharray="2 7"/>`);
  // actual path
  const start = [X0 + STEP, BASE];
  const path = [start, ...pts.filter(p => p[0] > start[0])];
  svg.push('<polyline fill="none" stroke="' + col('--ink') + '" stroke-width="2.5" points="' +
    path.map(p => p.join(',')).join(' ') + '"/>');

  let prev = start;
  marks.forEach(m => {
    const c = col('--ink'), ev = m.ev, id = 'e' + Math.floor(m.x);
    if (m.kind === 'spur') {
      const sx = prev[0] + 30, sy = prev[1] - 38;
      svg.push(`<g class="evt" data-e="${id}"><line x1="${prev[0]}" y1="${prev[1]}" x2="${sx}" y2="${sy}"
        stroke="${col('--fail')}" stroke-width="2"/>
        <text x="${sx}" y="${sy - 6}" fill="${col('--fail')}" text-anchor="middle" font-size="16">&times;</text></g>`);
    } else if (m.kind === 'rider' || m.kind === 'word') {
      const dir = m.kind === 'rider' ? 1 : -1;
      svg.push(`<g class="evt" data-e="${id}"><path d="M ${m.x} ${m.y} C ${m.x + 20 * dir} ${RIDERY + 40}, ${m.x + 40 * dir} ${RIDERY}, ${m.x + 50 * dir} ${RIDERY}"
        fill="none" stroke="${col('--rider')}" stroke-width="1.8" stroke-dasharray="5 4"/>
        <circle cx="${m.x}" cy="${m.y}" r="4" fill="${col('--rider')}"/></g>`);
    } else if (m.kind === 'basecamp') {
      svg.push(`<g class="evt" data-e="${id}"><rect x="${m.x - 6}" y="${m.y - 6}" width="12" height="12"
        fill="${col('--camp')}"/></g>`);
    } else if (m.kind === 'arrival' || m.kind === 'return') {
      const cc = m.kind === 'arrival' ? col('--arrive') : col('--fail');
      const label = m.kind === 'arrival' ? '⚑ arrival' : '↩ return';
      svg.push(`<g class="evt" data-e="${id}"><circle cx="${m.x}" cy="${m.y}" r="7" fill="${cc}"/>
        <text x="${m.x}" y="${m.y - 14}" fill="${cc}" text-anchor="middle" font-size="13">${label}</text></g>`);
    } else {
      svg.push(`<g class="evt" data-e="${id}"><circle cx="${m.x}" cy="${m.y}" r="4.5"
        fill="${m.kind === 'crossing' ? col('--arrive') : c}"/></g>`);
    }
    svg.push(`<text x="${m.x}" y="${BASE + 84 + (m.x / STEP % 2 ? 0 : 16)}" fill="${col('--faint')}"
      text-anchor="middle" font-size="11">${m.kind === 'spur' ? 'crossing ✕' : m.kind}</text>`);
    if (m.kind !== 'spur' && m.kind !== 'rider' && m.kind !== 'word') prev = [m.x, m.y];
  });
  svg.push(`<text x="${X0}" y="${RIDERY - 14}" fill="${col('--rider')}" font-size="12">home — the patron</text>`);
  svg.push(`<line x1="${X0}" y1="${RIDERY}" x2="${W - 20}" y2="${RIDERY}" stroke="${col('--rider')}"
    stroke-width="1" stroke-dasharray="1 6" opacity=".6"/>`);

  const sec = document.createElement('section');
  sec.innerHTML = '<h2>' + esc(name) + '</h2><div class="map"><svg width="' + W + '" height="' + H +
    '" viewBox="0 0 ' + W + ' ' + H + '">' + svg.join('') + '</svg></div>';
  document.getElementById('maps').appendChild(sec);

  const evs = sec.querySelectorAll('.evt');
  evs.forEach((g, i) => {
    const ev = marks[i] ? marks[i].ev : null;
    if (!ev) return;
    g.addEventListener('mousemove', e => showTip(e, ev));
    g.addEventListener('mouseleave', () => tip.style.display = 'none');
  });
}

const byExp = {};
JOURNEYS.forEach(ev => (byExp[ev.expedition] = byExp[ev.expedition] || []).push(ev));
Object.entries(byExp).forEach(([name, evs]) => render(name, evs));
</script>
</body>
</html>
"""


def main(argv):
    out = "map.html"
    files = []
    i = 0
    while i < len(argv):
        if argv[i] == "-o":
            out = argv[i + 1]
            i += 2
        else:
            files.append(argv[i])
            i += 1
    if not files:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    events = []
    for f in files:
        for lineno, raw in enumerate(Path(f).read_text().splitlines(), 1):
            if raw.strip():
                events.append(json.loads(raw))
    html = TEMPLATE.replace("__DATA__", json.dumps(events, indent=None))
    Path(out).write_text(html)
    print(f"rendered {len(events)} events from {len(files)} file(s) to {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
